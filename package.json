{
  "name": "zod-dbs-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Opinionated Zod schema generator for databases",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm run -r build",
    "start": "pnpm run build && node index.js",
    "dev": "tsx dev.ts",
    "fix": "biome check . --fix",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:integration && pnpm run test:types && pnpm run test:lint",
    "test:unit": "pnpm run -r test:unit",
    "test:integration:dynamodb": "pnpm vitest --project integration:dynamodb run",
    "test:integration:mongodb": "pnpm vitest --project integration:mongodb run",
    "test:integration:mssql": "pnpm vitest --project integration:mssql run",
    "test:integration:mysql": "pnpm vitest --project integration:mysql run",
    "test:integration:oracle": "pnpm vitest --project integration:oracle run",
    "test:integration:pg": "pnpm vitest --project integration:pg run",
    "test:integration:snowflake": "pnpm vitest --project integration:snowflake run",
    "test:integration:sqlite": "pnpm vitest --project integration:sqlite run",
    "test:integration": "pnpm run -r test:integration && pnpm run test:integration:dynamodb && pnpm run test:integration:mongodb && pnpm run test:integration:mssql && pnpm run test:integration:mysql && pnpm run test:integration:oracle && pnpm run test:integration:pg && pnpm run test:integration:snowflake && pnpm run test:integration:sqlite",
    "test:root:integrations": "pnpm vitest run",
    "test:types": "tsc --noEmit && pnpm run -r test:types",
    "test:lint": "biome ci --diagnostic-level error",
    "test:lint:fix": "biome check --write",
    "new-version": "changeset && changeset version && pnpm fix && pnpm i",
    "publish-packages": "pnpm run build && pnpm publish --recursive --provenance --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msunbay/zod-dbs.git"
  },
  "author": "msunbay",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1126.0",
    "@biomejs/biome": "^2.5.12",
    "@changesets/cli": "^3.0.1",
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/mssqlserver": "^12.1.0",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/debug": "^4.1.12",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24",
    "@types/pluralize": "^0.0.33",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "^17.2.3",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4",
    "zod-dbs": "workspace:*",
    "zod-dbs-core": "workspace:*",
    "zod-dbs-dynamodb": "workspace:*",
    "zod-dbs-mongodb": "workspace:*",
    "zod-dbs-mssql": "workspace:*",
    "zod-dbs-mysql": "workspace:*",
    "zod-dbs-oracle": "workspace:*",
    "zod-dbs-pg": "workspace:*",
    "zod-dbs-snowflake": "workspace:*",
    "zod-dbs-sqlite": "workspace:*"
  }
}
